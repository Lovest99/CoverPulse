# GEMINI_API_KEY: Required for server-side Gemini decision-support explanations.
# Configure via Settings > Secrets in AI Studio.
GEMINI_API_KEY=""

# APP_URL: Public URL where CoverPulse is hosted (used for webhook docs and callbacks).
APP_URL="http://localhost:3000"

# Cloud SQL PostgreSQL runtime variables (injected automatically by AI Studio Cloud SQL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional external provider credentials — not required to run CoverPulse.
# In-App Worker PWA delivery and sandbox logging work out of the box.
# Add any of these in Settings > Secrets later when connecting live gateways:
# SMS_PROVIDER_API_KEY="MY_SMS_PROVIDER_API_KEY"
# SMS_PROVIDER_FROM="+61400000000"
# EMAIL_PROVIDER_API_KEY="MY_EMAIL_PROVIDER_API_KEY"
# EMAIL_PROVIDER_FROM="shifts@coverpulse.example.com.au"
# BILLING_WEBHOOK_SECRET="MY_BILLING_WEBHOOK_SECRET"
